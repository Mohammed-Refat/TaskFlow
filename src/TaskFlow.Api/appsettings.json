{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
},
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=taskflow;Username=postgres;Password=postgres"
  },
  "JwtOptions": {
    "Secret": "your-super-secret-key-that-is-at-least-32-characters",
    "Issuer": "TaskFlow.Api",
    "Audience": "TaskFlow.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  }
}